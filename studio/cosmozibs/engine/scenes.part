
/* =============== COSMOZIBS EPISODE RENDERER =============== */
const SPACE = '#1f2a52', SAND = '#e6c99f', OK = '#3fae9e', RED = '#e2433a', YEL = '#f9d65c';
const ease = (t) => eio(clamp(t));
const txt = (s, x, y, size, fill = '#fff', anchor = 'middle', sw = .2, rot = 0, sc = 1) =>
  `<g transform="translate(${r1(x)},${r1(y)}) rotate(${rot}) scale(${r1(sc * 100) / 100})"><text text-anchor="${anchor}" font-family="Poppins, sans-serif" font-weight="700" font-size="${size}" fill="${fill}" stroke="${INK}" stroke-width="${r1(size * sw)}" paint-order="stroke" stroke-linejoin="round" letter-spacing="${r1(size * .03)}">${String(s).replace(/&/g, '&amp;')}</text></g>`;
const star5 = (cx, cy, r, f = YEL) => { const p = []; for (let i = 0; i < 10; i++) { const a = -Math.PI / 2 + i * Math.PI / 5, rr = i % 2 ? r * .45 : r; p.push([cx + Math.cos(a) * rr, cy + Math.sin(a) * rr]); } return poly(p, f, 5); };
function starsBox(w, h, n, t, seed = 1) { let g = ''; for (let i = 0; i < n; i++) { const tw = .5 + .5 * Math.sin(t * 3 + i * 1.7); g += `<circle cx="${r1(rnd(i * 3.1 + seed) * w)}" cy="${r1(rnd(i * 7.7 + seed) * h)}" r="${r1(1.5 + tw * 3)}" fill="#fff6c8" opacity="${r1(.3 + tw * .6)}"/>`; } return g; }

/* ---------- planets ---------- */
const PCOL = { venus: '#f2c77a', jupiter: '#e8b98a', neptune: '#4a7fe0', exo: '#2f56c9', earth: '#6fa8e8', mercury: '#a9a39b', ganymede: '#b8a891', sun: YEL, star: '#ffb347', pulsar: '#e8f4ff', giant: '#e2433a', mars: '#e0764a', saturn: '#ead08a', uranus: '#9fe0e6', moon: '#d8d4cc' };
function planet(kind, cx, cy, r, t, boil, opt = {}) {
  if (kind === 'blackhole') {   // dark hole with a glowing, spinning disk
    let g = `<ellipse cx="${cx}" cy="${cy}" rx="${r * 1.55}" ry="${r * .42}" fill="none" stroke="#ff9a3c" stroke-width="${r * .22}" opacity=".9"/>`;
    for (let i = 0; i < 8; i++) { const a = t * 2.2 + i * .785, x = cx + Math.cos(a) * r * 1.55, y = cy + Math.sin(a) * r * .42; g += `<circle cx="${r1(x)}" cy="${r1(y)}" r="${r1(r * .06)}" fill="${YEL}"/>`; }
    g += roughSVG('circle', [cx, cy, r * 1.6], { fill: '#06040d', fillStyle: 'solid', stroke: '#ffcf6b', strokeWidth: Math.max(4, r * .05), roughness: 1.1 }, boil);
    return g + `<path d="M${cx - r * 1.55},${cy} A${r * 1.55},${r * .42} 0 0 0 ${cx + r * 1.55},${cy}" fill="none" stroke="#ffb347" stroke-width="${r * .22}"/>`;
  }
  if (kind === 'oumuamua') {   // long reddish cigar-shaped rock, tumbling
    const rot = Math.sin(t * 1.3) * 25 - 15;
    let g = `<g transform="rotate(${r1(rot)} ${cx} ${cy})">` + roughSVG('ellipse', [cx, cy, r * 2.4, r * .42], { fill: '#b5654a', fillStyle: 'solid', stroke: INK, strokeWidth: Math.max(4, r * .04), roughness: 1.4 }, boil);
    [[-.6, -.02, .08], [.1, .05, .06], [.6, -.03, .05]].forEach(([dx, dy, rr]) => g += `<circle cx="${cx + dx * r}" cy="${cy + dy * r}" r="${rr * r}" fill="rgba(0,0,0,.18)" stroke="${INK}" stroke-width="3"/>`);
    return g + '</g>';
  }
  const id = 'pc' + kind + Math.round(cx) + Math.round(cy);
  let g = roughSVG('circle', [cx, cy, r * 2], { fill: PCOL[kind] || '#ccc', fillStyle: 'solid', stroke: INK, strokeWidth: Math.max(4, r * .04), roughness: 1.1 }, boil);
  g += `<clipPath id="${id}"><circle cx="${cx}" cy="${cy}" r="${r - 3}"/></clipPath><g clip-path="url(#${id})">`;
  if (kind === 'jupiter') {
    [[-.62, '#c98a5a'], [-.3, '#f3d2ae'], [-.05, '#c98a5a'], [.22, '#f3d2ae'], [.5, '#b9784c'], [.75, '#f3d2ae']].forEach(([dy, c], i) => {
      g += `<path d="M${cx - r},${cy + dy * r} q${r * .5},${Math.sin(t * 2 + i) * 8} ${r},0 t${r},0" fill="none" stroke="${c}" stroke-width="${r * .16}"/>`; });
    g += `<ellipse cx="${cx + r * .32}" cy="${cy + r * .36}" rx="${r * .26}" ry="${r * .14}" fill="#d9573f" stroke="${INK}" stroke-width="${Math.max(3, r * .025)}"/>`;
  } else if (kind === 'venus') {
    for (let i = 0; i < 5; i++) g += `<path d="M${cx - r + ((t * 30 + i * 70) % (r * 2.2)) - r * .2},${cy - r * .6 + i * r * .3} q${r * .3},${-r * .12} ${r * .6},0" fill="none" stroke="#fbe3b0" stroke-width="${r * .08}" stroke-linecap="round"/>`;
  } else if (kind === 'neptune' || kind === 'exo') {
    for (let i = 0; i < 6; i++) { const x0 = cx - r + ((t * (kind === 'exo' ? 260 : 160) + i * 90) % (r * 2.6)) - r * .3, y0 = cy - r * .7 + i * r * .28; g += `<line x1="${r1(x0)}" y1="${r1(y0)}" x2="${r1(x0 + r * .4)}" y2="${r1(y0)}" stroke="#bfe0ff" stroke-width="${r * .05}" stroke-linecap="round" opacity=".8"/>`; }
    if (kind === 'neptune') g += `<ellipse cx="${cx - r * .3}" cy="${cy - r * .1}" rx="${r * .18}" ry="${r * .09}" fill="#2c4f9e"/>`;
  } else if (kind === 'earth') {
    const off = (t * 20) % (r * 2);
    [[-.4, -.3, .5, .35], [.35, .2, .45, .5], [-.1, .55, .3, .2]].forEach(([dx, dy, rx, ry]) => { for (const o of [-r * 2, 0]) g += `<ellipse cx="${r1(cx + dx * r + off + o)}" cy="${r1(cy + dy * r)}" rx="${r1(rx * r)}" ry="${r1(ry * r)}" fill="#7cc576" stroke="${INK}" stroke-width="4"/>`; });
  } else if (kind === 'mercury' || kind === 'ganymede' || kind === 'moon') {
    [[-.3, -.2, .18], [.35, .3, .14], [.1, -.45, .1], [-.4, .4, .1]].forEach(([dx, dy, rr]) => g += `<circle cx="${cx + dx * r}" cy="${cy + dy * r}" r="${rr * r}" fill="rgba(0,0,0,.14)" stroke="${INK}" stroke-width="3"/>`);
  }
  g += '</g>';
  if (opt.face) g += `<circle cx="${cx - r * .22}" cy="${cy - r * .05}" r="${r * .07}" fill="${INK}"/><circle cx="${cx + r * .22}" cy="${cy - r * .05}" r="${r * .07}" fill="${INK}"/><path d="M${cx - r * .18},${cy + r * .2} q${r * .18},${r * .16} ${r * .36},0" fill="none" stroke="${INK}" stroke-width="${r * .04}" stroke-linecap="round"/>`;
  return g;
}

/* ---------- scenes: local box 1000 x 600 ---------- */
const SC = {};
SC.title = (s, t, b) => {
  let g = planet('venus', 140, 140, 70, t, b) + planet('jupiter', 860, 150, 95, t, b) + planet('neptune', 150, 470, 60, t, b + 1) + planet('exo', 860, 470, 70, t, b + 2);
  const words = s.text.split(' '), lines = ['']; for (const w of words) { if ((lines.at(-1) + ' ' + w).trim().length > 13) lines.push(w); else lines[lines.length - 1] = (lines.at(-1) + ' ' + w).trim(); }
  lines.forEach((l, i) => g += txt(l, 500, 300 - (lines.length - 1) * 38 + i * 76 + 26, 64, i % 2 ? YEL : '#fff', 'middle', .2, -2, eoBack(P(t, .1 + i * .15, .45 + i * .15))));
  return g;
};
SC.lineup = SC.crew = (s, t, b, ctx) => crewRow(500, 520, 1.25, t, b, ctx, 190);
SC.planet = (s, t, b) => {
  const sc = eoBack(P(t, 0, .5)), z = s.zoom ? 1 + ease(P(t, .2, 1.5)) * .9 : 1;
  const r = 210 * sc * z, cx = s.zoom ? 500 - 160 * (z - 1) : 500, cy = s.zoom ? 330 - 170 * (z - 1) : 330;
  let g = planet(s.kind, cx, cy, r, t, b, { face: !s.zoom && !['exo', 'jupiter'].includes(s.kind) });
  if (s.kind === 'exo') for (let i = 0; i < 14; i++) { const x = ((t * 520 + i * 160) % 1200) - 100, y = 90 + rnd(i) * 440; g += `<polygon points="${r1(x)},${r1(y)} ${r1(x + 34)},${r1(y + 6)} ${r1(x + 8)},${r1(y + 16)}" fill="#dff4ff" stroke="${INK}" stroke-width="3"/>`; }
  if (s.label) g += txt(s.label, 500, 70, 64, '#fff', 'middle', .2, -2, eoBack(P(t, .3, .6)));
  return g;
};
SC.blanket = (s, t, b) => {
  let g = planet('venus', 500, 320, 170, t, b);
  g += roughSVG('circle', [500, 320, 470], { stroke: '#fbe3b0', strokeWidth: 30, roughness: 2.2, fill: 'none' }, b) + roughSVG('circle', [500, 320, 470], { stroke: INK, strokeWidth: 5, roughness: 2.2 }, b + 3);
  for (let i = 0; i < 6; i++) { const a = i / 6 * Math.PI * 2 + t * 1.5, r0 = 175 + ((t * 120 + i * 30) % 50); g += pen(jitter([[500 + Math.cos(a) * r0, 320 + Math.sin(a) * r0], [500 + Math.cos(a + .15) * (r0 + 30), 320 + Math.sin(a + .15) * (r0 + 30)], [500 + Math.cos(a + .3) * (r0 + 5), 320 + Math.sin(a + .3) * (r0 + 5)]], b + i, 2), 1, 9, RED); }
  return g + txt('HEAT TRAPPED!', 500, 70, 60, YEL, 'middle', .2, -2, eoBack(P(t, .4, .7)));
};
SC.thermo = (s, t, b) => {
  const f = ease(P(t, .2, 1.8)), ov = f > .98 ? Math.sin(t * 30) * 4 : 0;
  let g = `<g transform="translate(${330 + ov},0)">`;
  g += roughSVG('rectangle', [-38, 60, 76, 400], { fill: '#fff', fillStyle: 'solid', stroke: INK, strokeWidth: 7 }, b) + roughSVG('circle', [0, 500, 120], { fill: RED, fillStyle: 'solid', stroke: INK, strokeWidth: 7 }, b + 1);
  g += `<rect x="-20" y="${r1(460 - 380 * f)}" width="40" height="${r1(380 * f + 20)}" fill="${RED}"/>`;
  for (let i = 0; i < 8; i++) g += stick(38, 100 + i * 45, 60, 100 + i * 45, 5);
  g += '</g>' + txt(s.value, 700, 260, 120, RED, 'middle', .16, -3, eoBack(P(t, 1.2, 1.6))) + txt(s.label, 700, 340, 46, '#fff', 'middle', .22, 0, eoBack(P(t, 1.3, 1.7)));
  // oven doodle
  g += `<g transform="translate(700,450) scale(${eoBack(P(t, .6, 1))})">` + roughSVG('rectangle', [-80, -60, 160, 110], { fill: '#cfd3da', fillStyle: 'solid', stroke: INK, strokeWidth: 6 }, b) + roughSVG('rectangle', [-60, -35, 120, 65], { fill: '#2a2a2a', fillStyle: 'solid', stroke: INK, strokeWidth: 5 }, b + 2) + `<circle cx="-50" cy="-48" r="6" fill="${INK}"/><circle cx="-28" cy="-48" r="6" fill="${INK}"/></g>`;
  return g + txt(s.compare + ': WAY LESS', 700, 560, 30, '#fff', 'middle', .25);
};
SC.versus = (s, t, b) => {
  const pa = eoBack(P(t, 0, .4)), pb = eoBack(P(t, .3, .7));
  const ra = s.win === 'a' ? 160 : 110, rb = s.win === 'b' ? 160 : 110;
  let g = planet(s.a, 270, 320, ra * pa, t, b) + planet(s.b, 730, 320, rb * pb, t, b + 1);
  g += txt(s.a.toUpperCase(), 270, 540, 44, '#fff', 'middle', .22) + txt(s.b.toUpperCase(), 730, 540, 44, '#fff', 'middle', .22);
  g += txt('VS', 500, 340, 70, YEL, 'middle', .2, 0, eoBack(P(t, .5, .8)));
  if (s.win) { const wx = s.win === 'a' ? 270 : 730, wr = s.win === 'a' ? ra : rb; g += `<g transform="translate(${wx},${320 - wr - 30}) scale(${eoBack(P(t, 1, 1.3))})">` + poly([[-50, 20], [-50, -30], [-25, 0], [0, -40], [25, 0], [50, -30], [50, 20]], YEL, 6) + '</g>'; }
  if (s.label) g += txt(s.label, 500, 80, 60, YEL, 'middle', .2, -2, eoBack(P(t, 1.1, 1.4)));
  return g;
};
SC.pressure = (s, t, b) => {
  let g = roughSVG('rectangle', [120, 40, 760, 540], { fill: '#3b88c3', fillStyle: 'solid', stroke: INK, strokeWidth: 7 }, b);
  g += `<rect x="124" y="44" width="752" height="40" fill="#8fd3ff"/>`;
  const d = ease(P(t, .2, 2.5)), y = 110 + d * 380;
  g += `<g transform="translate(420,${r1(y)})">` + roughSVG('circle', [0, 0, 70], { fill: '#f6f6f2', fillStyle: 'solid', stroke: INK, strokeWidth: 5 }, b) + `<circle cx="0" cy="0" r="22" fill="#2a3d6b"/><circle cx="-7" cy="-3" r="5" fill="#fff"/><circle cx="8" cy="-3" r="5" fill="#fff"/>` + '</g>';
  for (let i = 0; i < 5; i++) { const by = 560 - ((t * 90 + i * 110) % 480); g += `<circle cx="${450 + Math.sin(by / 30 + i) * 12}" cy="${r1(by)}" r="${6 + i % 3 * 3}" fill="none" stroke="#dff4ff" stroke-width="3"/>`; }
  g += stick(700, 90, 700, 560, 6); for (let i = 0; i <= 5; i++) g += stick(690, 90 + i * 94, 715, 90 + i * 94, 5);
  g += txt(Math.round(d * 930) + ' m', 760, r1(y) + 16, 46, '#fff', 'start', .22);
  return g + txt(s.label, 500, 30, 44, YEL, 'middle', .22);
};
SC.daybar = (s, t, b) => {
  const m = Math.max(s.av, s.bv), fa = ease(P(t, .2, 1.6)), fb = ease(P(t, .7, 2.1));
  const ls = (w) => Math.min(52, Math.round(360 / String(w).length));
  let g = txt(s.a, 145, 230, ls(s.a), '#fff', 'middle', .22) + txt(s.b, 145, 410, ls(s.b), '#fff', 'middle', .22);
  g += roughSVG('rectangle', [280, 180, 640 * s.av / m * fa + 1, 80], { fill: YEL, fillStyle: 'solid', stroke: INK, strokeWidth: 6 }, b);
  g += roughSVG('rectangle', [280, 360, 640 * s.bv / m * fb + 1, 80], { fill: OK, fillStyle: 'solid', stroke: INK, strokeWidth: 6 }, b + 1);
  g += txt(Math.round(s.av * fa), 300 + 640 * s.av / m * fa, 238, 46, '#fff', 'start', .22) + txt(Math.round(s.bv * fb), 300 + 640 * s.bv / m * fb, 418, 46, '#fff', 'start', .22);
  return g + txt(s.unit.toUpperCase(), 500, 540, 40, '#c9d3ff', 'middle', .22) + txt(s.label || 'DAY > YEAR?!', 500, 90, 64, YEL, 'middle', .2, -2, eoBack(P(t, 2, 2.3)));
};
SC.quiz = (s, t, b, ctx) => {
  let g = txt('QUIZ TIME!', 500, 70, 58, YEL, 'middle', .2, -3, eoBack(P(t, 0, .3))) + txt(s.q, 500, 160, 46, '#fff', 'middle', .22, 0, eoBack(P(t, .2, .5)));
  s.options.forEach((o, i) => { const x = 180 + i * 320, p = eoBack(P(t, .4 + i * .2, .7 + i * .2)), win = ctx.revealed && i === s.answer;
    g += `<g transform="translate(${x},350) scale(${p * (win ? 1.12 : 1)})">` + roughSVG('rectangle', [-140, -70, 280, 140], { fill: win ? OK : '#fff', fillStyle: 'solid', stroke: INK, strokeWidth: 7 }, b + i) + `<circle cx="-110" cy="-50" r="26" fill="${YEL}" stroke="${INK}" stroke-width="5"/>` + txt('ABC'[i], -110, -38, 32, INK, 'middle', 0) + txt(o, 0, 18, o.length > 8 ? 34 : 44, win ? '#fff' : INK, 'middle', win ? .2 : 0) + '</g>'; });
  const cd = ctx.lineEnd !== undefined ? t - ctx.lineEnd : -1;
  if (cd > 0 && cd < 4) { const n = 4 - Math.floor(cd); g += `<g transform="translate(500,520) scale(${1.4 - (cd % 1) * .4})">` + `<circle r="50" fill="${RED}" stroke="${INK}" stroke-width="7"/>` + txt(n, 0, 20, 60, '#fff', 'middle', 0) + '</g>'; }
  return g;
};
SC.sunrise = (s, t, b) => {
  const up = ease(P(t, .2, 2.2));
  let g = `<rect x="0" y="0" width="1000" height="600" fill="#f39a5c" opacity="${r1(up * .6)}"/>`;
  g += planet('sun', 230, 470 - up * 260, 90, t, b);
  g += roughSVG('rectangle', [-20, 440, 1040, 180], { fill: '#c9894e', fillStyle: 'solid', stroke: INK, strokeWidth: 7 }, b);
  g += txt('W', 230, 560, 70, '#fff', 'middle', .2) + txt('E', 780, 560, 70, '#fff', 'middle', .2);
  return g + txt('SUNRISE IN THE WEST!', 500, 80, 60, YEL, 'middle', .2, -2, eoBack(P(t, 1.2, 1.5)));
};
SC.dive = (s, t, b) => {
  let g = '';
  for (let i = 0; i < 7; i++) g += `<path d="M-20,${60 + i * 80} q260,${Math.sin(t * 2 + i) * 30} 520,0 t520,0" fill="none" stroke="${['#c98a5a', '#f3d2ae', '#b9784c'][i % 3]}" stroke-width="70" opacity=".9"/>`;
  const d = ease(P(t, .2, 3)), y = 40 + d * 470, sq = d > .85 ? 1 - (d - .85) * 3 : 1;
  g += `<g transform="translate(500,${r1(y)}) scale(${r1(1 + (1 - sq) * .6)},${r1(sq)})">` + poly([[0, -70], [36, -10], [36, 50], [-36, 50], [-36, -10]], '#f4f4f0', 6) + `<circle cx="0" cy="0" r="16" fill="#7fd3f3" stroke="${INK}" stroke-width="5"/>` + '</g>';
  if (d > .85) g += txt('CRUNCH!', 500, 300, 90, RED, 'middle', .18, -6, eoBack(P(d, .85, .95)));
  return g + txt('NO SURFACE!', 500, 70, 60, '#fff', 'middle', .22, -2, eoBack(P(t, .3, .6)));
};
SC.fill = (s, t, b) => {
  let g = roughSVG('circle', [500, 330, 520], { stroke: INK, strokeWidth: 8, fill: 'rgba(232,185,138,.25)', fillStyle: 'solid' }, b);
  const f = ease(P(t, .3, 3.2)), n = 330, show = Math.floor(n * f);
  for (let i = 0; i < show; i++) { const a = i * 2.39996, rr = 240 * Math.sqrt((i + .5) / n); g += `<circle cx="${r1(500 + Math.cos(a) * rr)}" cy="${r1(330 + Math.sin(a) * rr)}" r="9" fill="#6fa8e8" stroke="${INK}" stroke-width="2"/>`; }
  return g + txt(Math.round(s.count * f).toLocaleString('en-US'), 500, 350, 120, YEL, 'middle', .16) + txt(s.label, 500, 50, 58, '#fff', 'middle', .22, -2, eoBack(P(t, .2, .5)));
};
SC.bignum = (s, t, b) => {
  let g = '';
  for (let i = 0; i < 16; i++) { const a = i / 16 * Math.PI * 2 + t * .4; g += `<line x1="${500 + Math.cos(a) * 170}" y1="${290 + Math.sin(a) * 170}" x2="${500 + Math.cos(a) * 300}" y2="${290 + Math.sin(a) * 300}" stroke="${YEL}" stroke-width="10" stroke-linecap="round" opacity=".5"/>`; }
  return g + txt(s.value, 500, 340, 170, YEL, 'middle', .14, -3, eoBack(P(t, .1, .5))) + txt(s.label, 500, 500, 48, '#fff', 'middle', .22, 0, eoBack(P(t, .4, .7)));
};
SC.wind = (s, t, b) => {
  let g = '';
  for (let i = 0; i < 18; i++) { const y = 40 + rnd(i) * 520, x = ((t * (900 + rnd(i * 3) * 600) + rnd(i * 5) * 1200) % 1300) - 200; g += pen(jitter([[x, y], [x + 80, y - 6], [x + 160, y]], b + i, 2), 1, 8, '#bfe0ff'); }
  const p = ease(P(t, .2, 1.4)), a = Math.PI * (1 + p * .95) + (p > .95 ? Math.sin(t * 40) * .03 : 0);
  g += `<path d="M300,420 A200,200 0 0 1 700,420" fill="#fff" stroke="${INK}" stroke-width="8"/>`;
  for (let i = 0; i <= 8; i++) { const aa = Math.PI * (1 + i / 8); g += stick(500 + Math.cos(aa) * 170, 420 + Math.sin(aa) * 170, 500 + Math.cos(aa) * 195, 420 + Math.sin(aa) * 195, i > 6 ? 8 : 5); }
  g += `<line x1="500" y1="420" x2="${r1(500 + Math.cos(a) * 170)}" y2="${r1(420 + Math.sin(a) * 170)}" stroke="${RED}" stroke-width="12" stroke-linecap="round"/><circle cx="500" cy="420" r="18" fill="${INK}"/>`;
  return g + txt(s.value, 500, 530, 80, YEL, 'middle', .18, -2, eoBack(P(t, 1, 1.3))) + txt(s.label, 500, 80, 50, '#fff', 'middle', .22);
};
SC.sunlight = (s, t, b) => {
  let g = planet('sun', 90, 300, 110, t, b) + planet('earth', 300, 300, 30, t, b) + planet('neptune', 900, 300, 60, t, b + 1);
  const p = ease(P(t, .4, 3.4)); g += `<line x1="200" y1="300" x2="${r1(200 + 630 * p)}" y2="300" stroke="${YEL}" stroke-width="16" stroke-linecap="round" stroke-dasharray="30 18"/>`;
  return g + txt('8 MIN', 300, 400, 40, '#fff', 'middle', .22, 0, eoBack(P(t, .6, .9))) + txt(s.label, 900, 420, 56, YEL, 'middle', .2, 0, eoBack(P(t, 3.2, 3.5))) + txt('SUNLIGHT TRAVEL TIME', 500, 90, 48, '#fff', 'middle', .22);
};
SC.glassrain = (s, t, b) => {
  let g = roughSVG('rectangle', [0, 0, 1000, 600], { fill: '#2f56c9', fillStyle: 'solid', stroke: 'none' }, b);
  for (let i = 0; i < 4; i++) g += roughSVG('ellipse', [150 + i * 240, 90 + (i % 2) * 30, 260, 90], { fill: '#8fb0ff', fillStyle: 'solid', stroke: INK, strokeWidth: 5 }, b + i);
  for (let i = 0; i < 26; i++) { const y = 170 + rnd(i) * 400, x = ((t * 700 + rnd(i * 7) * 1300) % 1300) - 150; g += `<polygon points="${r1(x)},${r1(y)} ${r1(x + 46)},${r1(y + 8)} ${r1(x + 10)},${r1(y + 22)}" fill="#e8f8ff" stroke="${INK}" stroke-width="3"/>` + `<line x1="${r1(x - 70)}" y1="${r1(y + 8)}" x2="${r1(x - 10)}" y2="${r1(y + 10)}" stroke="#fff" stroke-width="3" opacity=".6"/>`; }
  return g + txt('GLASS RAIN →', 500, 570, 54, YEL, 'middle', .2, -2);
};
SC.nomoon = (s, t, b) => {
  let g = planet('venus', 500, 320, 150, t, b, { face: true });
  g += `<ellipse cx="500" cy="320" rx="330" ry="120" fill="none" stroke="#fff" stroke-width="5" stroke-dasharray="18 14" opacity=".7"/>`;
  const a = t * 1.2; g += txt('?', 500 + Math.cos(a) * 330, 340 + Math.sin(a) * 120, 80, YEL, 'middle', .18);
  return g + txt('NO MOON!', 500, 80, 64, YEL, 'middle', .2, -2, eoBack(P(t, .3, .6)));
};
SC.acid = (s, t, b) => {
  let g = '';
  for (let i = 0; i < 3; i++) g += roughSVG('ellipse', [220 + i * 280, 200, 300, 150], { fill: '#d9e36a', fillStyle: 'solid', stroke: INK, strokeWidth: 6 }, b + i);
  for (let i = 0; i < 14; i++) { const x = 120 + (i * 61) % 760, y = 270 + ((t * 220 + i * 47) % 300); g += `<path d="M${x},${y} q-12,22 0,28 q12,-6 0,-28z" fill="#9be15d" stroke="${INK}" stroke-width="4"/>`; }
  return g + txt('ACID CLOUDS!', 500, 80, 64, '#9be15d', 'middle', .2, -2, eoBack(P(t, .3, .6)));
};
SC.nightsky = (s, t, b) => {
  let g = roughSVG('rectangle', [0, 0, 1000, 600], { fill: '#141b38', fillStyle: 'solid', stroke: 'none' }, b) + starsBox(1000, 420, 40, t, 9);
  g += planet('moon', 790, 140, 60, t, b);
  const tw = 1 + Math.sin(t * 6) * .15; g += `<g transform="translate(260,170) scale(${tw})">` + star5(0, 0, 34, '#fff7c2') + '</g>';
  g += txt(s.label, 260, 260, 46, YEL, 'middle', .22, 0, eoBack(P(t, .6, .9)));
  g += roughSVG('rectangle', [-20, 470, 1040, 150], { fill: '#2b3a2e', fillStyle: 'solid', stroke: INK, strokeWidth: 6 }, b);
  g += `<g transform="translate(560,470)">` + poly([[-90, 0], [-90, -110], [0, -180], [90, -110], [90, 0]], '#c9894e', 6) + `<rect x="-40" y="-90" width="50" height="50" fill="#f9d65c" stroke="${INK}" stroke-width="5"/></g>`;
  return g;
};
SC.math = (s, t, b) => {
  let g = roughSVG('rectangle', [60, 40, 880, 420], { fill: '#2f5b45', fillStyle: 'solid', stroke: '#8a5a34', strokeWidth: 18 }, b);
  const eq = ['x + y = ?', 'orbit ≠ predicted', '→ hidden planet!'];
  eq.forEach((e, i) => g += `<text x="120" y="${130 + i * 100}" font-family="Poppins, sans-serif" font-weight="500" font-size="54" fill="#f2f2e8" opacity="${r1(clamp(P(t, i * .6, i * .6 + .3)))}">${e}</text>`);
  g += planet('neptune', 800, 250, 70 * eoBack(P(t, 2, 2.4)), t, b);
  return g + txt('FOUND WITH MATH · 1846', 500, 550, 52, YEL, 'middle', .2, -2, eoBack(P(t, 2.2, 2.5)));
};
SC.voyager = (s, t, b) => {
  let g = planet('neptune', 720, 330, 170, t, b);
  const x = -150 + ((t * 120) % 1300), y = 200 + Math.sin(t) * 20;
  g += `<g transform="translate(${r1(x)},${r1(y)}) rotate(-10)">` + stick(-80, 0, 80, 0, 6) + stick(0, 0, 0, 70, 5) + `<path d="M-50,-60 A70,70 0 0 0 50,-60 Z" fill="#f4f4f0" stroke="${INK}" stroke-width="6"/>` + `<rect x="-22" y="-20" width="44" height="40" fill="#d6b45a" stroke="${INK}" stroke-width="5"/></g>`;
  return g + txt(s.label, 500, 80, 60, YEL, 'middle', .2, -2, eoBack(P(t, .4, .7)));
};

SC.speed = (s, t, b) => {
  if (!s.n) { let g = ''; for (let i = 0; i < 3; i++) g += pen(jitter([[300 + i * 160, 100], [250 + i * 160, 300], [330 + i * 160, 300], [270 + i * 160, 500]], b + i, 2), ease(P(t, i * .1, .3 + i * .1)), 22, YEL); return g + txt(s.text, 500, 340, 110, '#fff', 'middle', .16, -4, eoBack(P(t, .1, .5))); }
  let g = `<g transform="translate(500,300) rotate(${(s.n % 2 ? -2 : 2)}) scale(${eoBack(P(t, 0, .35))})">` + roughSVG('rectangle', [-430, -230, 860, 460], { fill: '#fdfcf7', fillStyle: 'solid', stroke: INK, strokeWidth: 8 }, b) + '</g>';
  g += `<g transform="translate(500,300) scale(${eoBack(P(t, 0, .35))}) translate(-500,-300)">` + planet(s.planet, 300, 300, 140, t, b + 2) + txt('#' + s.n, 720, 200, 100, RED, 'middle', .12) + '</g>';
  const words = s.text.split(' '), lines = ['']; for (const w of words) { if ((lines.at(-1) + ' ' + w).trim().length > 12) lines.push(w); else lines[lines.length - 1] = (lines.at(-1) + ' ' + w).trim(); }
  lines.forEach((l, i) => g += txt(l, 690, 310 + i * 64, 52, INK, 'middle', 0, 0, eoBack(P(t, .3, .6))));
  return g;
};
const ORDER8 = ['mercury', 'venus', 'earth', 'mars', 'jupiter', 'saturn', 'uranus', 'neptune'];
SC.map = (s, t, b) => {
  let g = planet('sun', -60, 300, 160, t, b);
  const hi = (s.hi || '').split(',');
  ORDER8.forEach((k, i) => { const x = 170 + i * 108, r = [14, 22, 23, 17, 46, 40, 30, 30][i];
    g += `<ellipse cx="-60" cy="300" rx="${x + 60}" ry="${r1((x + 60) * .55)}" fill="none" stroke="#fff" stroke-width="2" opacity=".25"/>`;
    const on = hi.includes(k), pop = on ? 1 + .15 * Math.sin(t * 6) : 1;
    g += `<g transform="translate(${x},300) scale(${pop}) translate(${-x},-300)">` + planet(k, x, 300, r, t, b + i) + '</g>';
    if (on) g += `<circle cx="${x}" cy="300" r="${r + 22}" fill="none" stroke="${YEL}" stroke-width="7"/>` + txt(k.toUpperCase(), x, 300 + r + 60, 30, YEL, 'middle', .25) + txt('#' + (i + 1), x, 300 - r - 32, 34, '#fff', 'middle', .25);
  });
  if (s.hi === 'none') g += txt('→ EVEN FURTHER!', 860, 120, 46, YEL, 'middle', .22, -3, eoBack(P(t, .3, .6)));
  return g;
};
SC.pick = (s, t, b) => {
  let g = txt('WHICH ONE WOULD YOU PICK?', 500, 70, 50, YEL, 'middle', .22, -2);
  ['venus', 'jupiter', 'neptune', 'exo'].forEach((k, i) => { const x = 140 + i * 240, p = eoBack(P(t, .2 + i * .2, .5 + i * .2)); g += `<g transform="translate(${x},300) scale(${p}) translate(${-x},-300)">` + planet(k, x, 300, 90, t, b + i) + '</g>' + txt(String(i + 1), x, 470, 64, '#fff', 'middle', .2, 0, p); });
  return g;
};

SC.poof = (s, t, b) => {   // a body vanishes in a puff
  const k = clamp((t - 1) / .5), sc = (1 - k) * eoBack(P(t, 0, .4));
  let g = planet(s.kind || 'moon', 500, 300, 180 * sc + .01, t, b, { face: k < .5 });
  if (k > 0) for (let i = 0; i < 10; i++) { const a = i / 10 * Math.PI * 2, r = 120 + k * 160; g += `<circle cx="${r1(500 + Math.cos(a) * r)}" cy="${r1(300 + Math.sin(a) * r)}" r="${r1(50 * (1 - k * .6))}" fill="#e8e4f0" stroke="${INK}" stroke-width="5" opacity="${r1(1 - k * .8)}"/>`; }
  if (k >= 1) g += txt('POOF!', 500, 330, 120, YEL, 'middle', .16, -6, eoBack(P(t, 1.5, 1.8)));
  return g + txt(s.label || '', 500, 70, 58, '#fff', 'middle', .22, -2);
};
SC.tides = (s, t, b) => {   // two waves: with and without the Moon
  const fa = ease(P(t, .2, 1.4)), fb = ease(P(t, .8, 2));
  const wave = (x0, y0, h, ph) => { let d = `M${x0},${y0}`; for (let i = 0; i <= 20; i++) d += ` L${x0 + i * 19},${r1(y0 - h * (.5 + .5 * Math.sin(i * .6 + t * 3 + ph)))}`; return `<path d="${d} L${x0 + 380},540 L${x0},540Z" fill="#3b88c3" stroke="${INK}" stroke-width="6" stroke-linejoin="round"/>`; };
  let g = wave(60, 470, 230 * fa, 0) + wave(560, 470, 90 * fb, 1);
  g += planet('moon', 250, 110, 50, t, b) + `<g opacity="${r1(1 - fb)}">${planet('moon', 750, 110, 50, t, b)}</g>` + txt('?', 750, 130, 70, YEL, 'middle', .2, 0, fb);
  return g + txt(s.a, 250, 590, 40, '#fff', 'middle', .22) + txt(s.b, 750, 590, 40, '#fff', 'middle', .22);
};
SC.tilt = (s, t, b) => {   // Earth's axis wobbling more and more
  const amp = 8 + ease(P(t, .5, 3)) * 35, a = 23.4 + Math.sin(t * 2.6) * amp;
  let g = planet('sun', 90, 300, 90, t, b) + `<g transform="rotate(${r1(a)} 600 300)">` + `<line x1="600" y1="60" x2="600" y2="540" stroke="${RED}" stroke-width="10" stroke-linecap="round" stroke-dasharray="26 14"/>` + planet('earth', 600, 300, 170, t, b) + '</g>';
  return g + txt(s.label || 'WOBBLE!', 600, 80, 58, YEL, 'middle', .2, -2, eoBack(P(t, .3, .6)));
};
SC.car = (s, t, b) => {   // a car driving from Earth to the Sun with a time counter
  const p = ease(P(t, .3, 4)), x = 200 + p * 520;
  let g = planet('earth', 110, 320, 70, t, b) + planet('sun', 1000, 320, 230, t, b);
  g += `<line x1="180" y1="400" x2="780" y2="400" stroke="#fff" stroke-width="5" stroke-dasharray="20 16" opacity=".6"/>`;
  g += `<g transform="translate(${r1(x)},${r1(370 + Math.sin(t * 20) * 2)})">` + roughSVG('rectangle', [-60, -30, 120, 40], { fill: RED, fillStyle: 'solid', stroke: INK, strokeWidth: 5 }, b) + roughSVG('rectangle', [-35, -58, 70, 32], { fill: '#bfe3f5', fillStyle: 'solid', stroke: INK, strokeWidth: 5 }, b + 1) + `<circle cx="-35" cy="12" r="15" fill="${INK}"/><circle cx="35" cy="12" r="15" fill="${INK}"/></g>`;
  return g + txt(s.value, 450, 160, 90, YEL, 'middle', .16, -3, eoBack(P(t, 3.6, 4))) + txt(s.label || '', 450, 540, 44, '#fff', 'middle', .22);
};
SC.daynight = (s, t, b) => {
  let g = planet('sun', 60, 300, 200, t, b);
  g += planet(s.kind || 'exo', 640, 300, 190, t, b + 1);
  g += `<path d="M640,110 A190,190 0 0 1 640,490 Z" fill="#0b1026" opacity=".75"/>`;
  return g + txt('DAY', 540, 310, 54, YEL, 'middle', .22) + txt('NIGHT', 740, 310, 54, '#c9d3ff', 'middle', .22) + txt(s.label || 'FOREVER!', 640, 570, 54, '#fff', 'middle', .22, -2, eoBack(P(t, .8, 1.1)));
};
SC.signal = (s, t, b) => {   // the 1977 computer printout, a code gets circled and "Wow!" written next to it
  let g = `<g transform="rotate(-3 500 320)">` + roughSVG('rectangle', [180, 60, 640, 500], { fill: '#fdfcf7', fillStyle: 'solid', stroke: INK, strokeWidth: 7 }, b);
  for (let r = 0; r < 9; r++) for (let c = 0; c < 6; c++) { const hot = c === 3 && r >= 2 && r <= 7;
    const ch = hot ? '6EQUJ5'[r - 2] : ' 1 1  2 1 1 3  1 '.charAt((r * 7 + c * 3) % 17).trim() || '1';
    g += `<text x="${250 + c * 95}" y="${120 + r * 52}" font-family="monospace" font-weight="700" font-size="40" fill="${hot ? RED : '#555'}">${ch}</text>`; }
  const k = ease(P(t, .8, 1.8)); g += roughSVG('ellipse', [547, 342, 92, 330], { stroke: RED, strokeWidth: 8, roughness: 2 }, b + 1, Math.max(k, .001)) + '</g>';
  return g + txt('Wow!', 760, 220, 80, RED, 'middle', .12, -12, eoBack(P(t, 1.6, 2))) + txt(s.label || '', 500, 590, 46, '#fff', 'middle', .22);
};
SC.lightcurve = (s, t, b) => {   // a star with a brightness graph that suddenly dips
  const dim = s.dip ? Math.max(0, Math.sin(clamp((t - 1.2) / 1.6) * Math.PI)) * s.dip / 100 : 0;
  let g = `<g opacity="${r1(1 - dim * 1.6)}">` + planet('star', 230, 280, 150, t, b, { face: true }) + '</g>';
  g += roughSVG('rectangle', [440, 120, 520, 330], { fill: '#fdfcf7', fillStyle: 'solid', stroke: INK, strokeWidth: 6 }, b + 1);
  let d = 'M460,180'; const n = Math.floor(ease(P(t, .2, 3)) * 48);
  for (let i = 1; i <= n; i++) { const x = 460 + i * 10, f = s.dip ? Math.max(0, Math.sin(clamp((i - 20) / 14) * Math.PI)) : 0; d += ` L${x},${r1(180 + f * s.dip * 10 + Math.sin(i * 1.7) * 3)}`; }
  g += `<path d="${d}" fill="none" stroke="${RED}" stroke-width="7" stroke-linejoin="round" stroke-linecap="round"/>` + txt('BRIGHTNESS', 700, 440, 30, INK, 'middle', 0);
  return g + txt(s.label || '', 500, 70, 56, YEL, 'middle', .2, -2, eoBack(P(t, .3, .6)));
};
SC.visitor = (s, t, b) => {   // 'Oumuamua zooming past the Sun and back out of the solar system
  const p = clamp(t / 5), x = -150 + p * 1300, y = 520 - Math.sin(p * Math.PI) * 330;
  let g = planet('sun', 500, 330, 90, t, b);
  g += `<path d="M-150,520 Q500,-140 1150,520" fill="none" stroke="#fff" stroke-width="4" stroke-dasharray="14 12" opacity=".5"/>`;
  for (let i = 1; i < 6; i++) g += `<line x1="${r1(x - i * 36)}" y1="${r1(y + i * 10)}" x2="${r1(x - i * 36 - 26)}" y2="${r1(y + i * 10 + 6)}" stroke="#fff" stroke-width="5" opacity="${r1(.6 - i * .1)}" stroke-linecap="round"/>`;
  g += planet('oumuamua', x, y, 70, t, b + 1);
  return g + txt(s.label || '', 500, 70, 56, YEL, 'middle', .2, -2, eoBack(P(t, .3, .6)));
};
SC.blackhole = (s, t, b) => {   // things spiral in and stretch like spaghetti
  let g = planet('blackhole', 500, 320, 150, t, b);
  for (let i = 0; i < 5; i++) { const ph = ((t * .35 + i * .2) % 1), a = i * 1.3 + ph * 5, rr = 420 * (1 - ph) + 60;
    const x = 500 + Math.cos(a) * rr, y = 320 + Math.sin(a) * rr * .5, st = 1 + ph * 2.5;
    g += `<g transform="translate(${r1(x)},${r1(y)}) rotate(${r1(a * 57.3 + 90)}) scale(${r1(1 / st)},${r1(st)})" opacity="${r1(1 - ph * .8)}">` + star5(0, 0, 26, i % 2 ? YEL : '#9fe0e6') + '</g>'; }
  return g + txt(s.label || '', 500, 70, 56, YEL, 'middle', .2, -2, eoBack(P(t, .3, .6)));
};
const MON = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
SC.calendar = (s, t, b) => {   // tear-off calendar page + a year bar with a marker sliding to the date
  const [m, d] = s.date.split(' '), mi = Math.max(0, MON.indexOf(m.slice(0, 3).toUpperCase())), pos = (mi + (+d || 1) / 31) / 12;
  const flip = eoBack(P(t, 0, .45));
  let g = `<g transform="translate(330,280) rotate(-3) scale(${flip}) translate(-330,-280)">` + roughSVG('rectangle', [170, 90, 320, 330], { fill: '#fdfcf7', fillStyle: 'solid', stroke: INK, strokeWidth: 7 }, b);
  g += `<rect x="170" y="90" width="320" height="80" fill="${RED}" stroke="${INK}" stroke-width="7"/>` + txt(m.toUpperCase(), 330, 148, 50, '#fff', 'middle', .12) + txt(d || '', 330, 340, 150, INK, 'middle', 0) + '</g>';
  if (s.kind) g += planet(s.kind, 760, 250, 130, t, b + 2, { face: true });
  g += `<rect x="60" y="500" width="880" height="26" rx="13" fill="#fff" opacity=".25"/>`;
  MON.forEach((mm, i) => g += txt(mm[0], 60 + (i + .5) * 880 / 12, 572, 28, '#fff', 'middle', .2));
  const x = 60 + 880 * pos * ease(P(t, .3, 1.6));
  g += `<rect x="60" y="500" width="${r1(x - 60)}" height="26" rx="13" fill="${YEL}" stroke="${INK}" stroke-width="4"/>` + star5(x, 513, 30 + 4 * Math.sin(t * 6));
  return g + txt(s.label || '', 760, 450, 46, YEL, 'middle', .22, -2, eoBack(P(t, .4, .7)));
};
SC.clock = (s, t, b) => {   // Dec 31 clock ticking toward midnight
  const [hh, mm] = (s.value || '23:50').split(':').map(Number), go = ease(P(t, .2, 1.8)), mins = 60 * 11 + (hh - 12) * 60 * 0 + mm * go;
  let g = roughSVG('circle', [380, 300, 440], { fill: '#fdfcf7', fillStyle: 'solid', stroke: INK, strokeWidth: 9 }, b);
  for (let i = 0; i < 12; i++) { const a = i / 12 * Math.PI * 2; g += `<line x1="${r1(380 + Math.sin(a) * 180)}" y1="${r1(300 - Math.cos(a) * 180)}" x2="${r1(380 + Math.sin(a) * 200)}" y2="${r1(300 - Math.cos(a) * 200)}" stroke="${INK}" stroke-width="8"/>`; }
  const am = (mm * go) / 60 * Math.PI * 2, ah = ((hh % 12) + mm * go / 60) / 12 * Math.PI * 2;
  g += `<line x1="380" y1="300" x2="${r1(380 + Math.sin(ah) * 110)}" y2="${r1(300 - Math.cos(ah) * 110)}" stroke="${INK}" stroke-width="16" stroke-linecap="round"/>`;
  g += `<line x1="380" y1="300" x2="${r1(380 + Math.sin(am) * 170)}" y2="${r1(300 - Math.cos(am) * 170)}" stroke="${RED}" stroke-width="10" stroke-linecap="round"/><circle cx="380" cy="300" r="14" fill="${INK}"/>`;
  g += txt('DEC 31', 790, 200, 70, '#fff', 'middle', .2, -3) + txt(s.value || '', 790, 320, 90, YEL, 'middle', .16, -3, eoBack(P(t, 1.6, 2)));
  return g + txt(s.label || '', 790, 430, 40, '#fff', 'middle', .22);
};
SC.volcano = (s, t, b) => {   // tiny Everest next to giant Olympus Mons growing up
  const f = ease(P(t, .3, 2)), h = 420 * f;
  let g = `<rect x="0" y="520" width="1000" height="80" fill="#b8573a" stroke="${INK}" stroke-width="6"/>`;
  g += poly([[60, 520], [130, 372], [200, 520]], '#d9d3c7', 6) + poly([[108, 418], [130, 372], [152, 418], [130, 405]], '#fff', 4) + txt('EVEREST', 130, 580, 30, '#fff', 'middle', .25);
  g += poly([[230, 520], [360, 520 - h * .55], [470, 520 - h * .93], [560, 520 - h], [650, 520 - h * .93], [760, 520 - h * .55], [990, 520]], '#e0764a', 7) + `<ellipse cx="560" cy="${r1(520 - h)}" rx="40" ry="10" fill="#7a2f1e" stroke="${INK}" stroke-width="5"/>`;
  return g + txt(s.label || 'OLYMPUS MONS', 600, 580, 34, YEL, 'middle', .22) + txt(s.value || '', 780, 130, 80, YEL, 'middle', .16, -3, eoBack(P(t, 1.8, 2.2)));
};
SC.pulsar = (s, t, b) => {   // a tiny dead star spinning with two light beams
  const a = t * 720 * (s.fast ? 2 : 1);
  let g = `<g transform="rotate(${r1(a % 360)} 500 320)">` + poly([[500, 320], [440, -200], [560, -200]], '#bfe0ff', 4).replace('<polygon', '<polygon opacity=".55"') + poly([[500, 320], [440, 840], [560, 840]], '#bfe0ff', 4).replace('<polygon', '<polygon opacity=".55"') + '</g>';
  g += roughSVG('circle', [500, 320, 130], { fill: '#e8f4ff', fillStyle: 'solid', stroke: INK, strokeWidth: 7 }, b);
  g += `<circle cx="470" cy="310" r="9" fill="${INK}"/><circle cx="530" cy="310" r="9" fill="${INK}"/><ellipse cx="500" cy="345" rx="12" ry="15" fill="#c9503f" stroke="${INK}" stroke-width="4"/>`;
  for (let i = 0; i < 3; i++) { const r = 95 + i * 22; g += `<path d="M${500 + r},320 A${r},${r} 0 0 1 ${500},${320 + r}" fill="none" stroke="${YEL}" stroke-width="6" stroke-linecap="round" transform="rotate(${r1(a * 1.3 + i * 120)} 500 320)"/>`; }
  return g + txt(s.label || '', 500, 70, 56, YEL, 'middle', .2, -2, eoBack(P(t, .3, .6))) + txt(s.value || '', 500, 560, 64, '#fff', 'middle', .2, 0, eoBack(P(t, .6, .9)));
};
SC.freeze = (s, t, b) => {   // thermometer dropping, ice crystals growing
  const f = ease(P(t, .2, 1.8));
  let g = `<g transform="translate(250,0)">` + roughSVG('rectangle', [-38, 60, 76, 400], { fill: '#fff', fillStyle: 'solid', stroke: INK, strokeWidth: 7 }, b) + roughSVG('circle', [0, 500, 120], { fill: '#5aa0e6', fillStyle: 'solid', stroke: INK, strokeWidth: 7 }, b + 1);
  g += `<rect x="-20" y="${r1(80 + 380 * f)}" width="40" height="${r1(380 * (1 - f) + 20)}" fill="#5aa0e6"/>`;
  for (let i = 0; i < 8; i++) g += stick(38, 100 + i * 45, 60, 100 + i * 45, 5);
  g += '</g>';
  for (let i = 0; i < 7; i++) { const x = 420 + rnd(i * 5) * 540, y = 80 + rnd(i * 9) * 440, r = 26 * eoBack(P(t, .3 + i * .15, .6 + i * .15));
    for (let k = 0; k < 3; k++) { const a = k * Math.PI / 3 + t * .3; g += `<line x1="${r1(x - Math.cos(a) * r)}" y1="${r1(y - Math.sin(a) * r)}" x2="${r1(x + Math.cos(a) * r)}" y2="${r1(y + Math.sin(a) * r)}" stroke="#dff4ff" stroke-width="6" stroke-linecap="round"/>`; } }
  return g + txt(s.value || '', 680, 280, 110, '#bfe0ff', 'middle', .16, -3, eoBack(P(t, 1.2, 1.6))) + txt(s.label || '', 680, 370, 44, '#fff', 'middle', .22, 0, eoBack(P(t, 1.3, 1.7)));
};
SC.bigstar = (s, t, b) => {   // a giant red star with our tiny Sun at its heart; orbit rings drawn on top
  const g0 = eoBack(P(t, .6, 1.6)), R = 240 * g0 + 1;
  let g = `<g opacity=".88">` + roughSVG('circle', [330, 320, R * 2], { fill: '#e2433a', fillStyle: 'solid', stroke: INK, strokeWidth: 8, roughness: 1.6 }, b) + '</g>';
  [['EARTH', 50], ['JUPITER', 200], ['SATURN', 280]].forEach(([n, r]) => g += `<circle cx="330" cy="320" r="${r}" fill="none" stroke="#fff" stroke-width="4" stroke-dasharray="12 10" opacity=".8"/>` + txt(n, 330 + r * .72, 320 - r * .72, 26, '#fff', 'middle', .3));
  g += planet('sun', 330, 320, 9, t, b + 1);
  return g + txt(s.label || '', 800, 280, 50, YEL, 'middle', .2, -2, eoBack(P(t, 1.4, 1.8))) + txt(s.value || '', 800, 360, 38, '#fff', 'middle', .22, 0, eoBack(P(t, 1.6, 2)));
};
/* ---------- Faith Doodles scenes (owner 20 Oct). Respect rule: never draw God or a prophet; tell stories with objects, places and symbols ---------- */
const wave = (y, amp, ph, col, t, b = 1) => {   // smooth crayon water: curved crest, hachure fill, sketchy outline that boils
  let d = `M-40,${r1(y)}`; for (let i = 0; i < 12; i++) { const x0 = -40 + i * 95, yy = (k) => y - amp * (.5 + .5 * Math.sin(k * .9 + t * 2.6 + ph)); d += ` Q${r1(x0 + 47)},${r1(yy(i + .5) - amp * .35)} ${r1(x0 + 95)},${r1(yy(i + 1))}`; }
  d += ' L1100,700 L-40,700Z';
  return roughSVG('path', [d], { fill: col, fillStyle: 'solid', stroke: 'none', roughness: 1.2 }, b) + roughSVG('path', [d], { fill: '#ffffff', fillStyle: 'hachure', hachureGap: 22, hachureAngle: -20, fillWeight: 3, stroke: INK, strokeWidth: 6, roughness: 1.6, bowing: 2 }, b + 3).replace('<g', '<g opacity=".9"');
};
const boat = (x, y, s, t, b = 1) => `<g transform="translate(${r1(x)},${r1(y + Math.sin(t * 2.4) * 8)}) rotate(${r1(Math.sin(t * 1.8) * 4)}) scale(${s})">`
  + roughSVG('path', ['M-170,-10 Q0,6 170,-10 Q150,30 120,60 L-120,60 Q-150,30 -170,-10Z'], { fill: '#a8683a', fillStyle: 'hachure', hachureGap: 9, fillWeight: 4, stroke: INK, strokeWidth: 7, roughness: 1.5 }, b)
  + roughSVG('rectangle', [-90, -80, 180, 70], { fill: '#d9a06a', fillStyle: 'cross-hatch', hachureGap: 12, fillWeight: 2.5, stroke: INK, strokeWidth: 6, roughness: 1.6 }, b + 1)
  + roughSVG('path', ['M-110,-80 L0,-132 L110,-80Z'], { fill: '#8a4f2a', fillStyle: 'hachure', hachureGap: 8, fillWeight: 4, stroke: INK, strokeWidth: 6, roughness: 1.5 }, b + 2)
  + `<circle cx="-40" cy="-46" r="12" fill="#3a2418"/><circle cx="40" cy="-46" r="12" fill="#3a2418"/></g>`;
SC.flood = (s, t, b) => {   // rain and rising water, a boat riding the waves
  let g = ''; for (let i = 0; i < 40; i++) { const x = rnd(i) * 1000, y = (t * 600 + rnd(i * 3) * 600) % 640 - 40; g += `<line x1="${r1(x)}" y1="${r1(y)}" x2="${r1(x - 10)}" y2="${r1(y + 34)}" stroke="#bfe0ff" stroke-width="5" stroke-linecap="round" opacity=".7"/>`; }
  const h = 120 + ease(P(t, 0, 3)) * 160;
  g += wave(640 - h, 50, 0, '#2f6fb0', t, b) + boat(500, 600 - h - 40, .9, t, b) + wave(660 - h * .6, 40, 2, '#3b88c3', t, b);
  return g + txt(s.label || '', 500, 70, 58, YEL, 'middle', .2, -2, eoBack(P(t, .3, .6)));
};
SC.tablet = (s, t, b) => {   // a cracked clay tablet with wedge writing
  let g = `<g transform="translate(500,320) rotate(-4) scale(${eoBack(P(t, 0, .45))})">` + roughSVG('rectangle', [-200, -230, 400, 460], { fill: '#c9a57a', fillStyle: 'solid', stroke: INK, strokeWidth: 8, roughness: 2.4 }, b);
  for (let r = 0; r < 9; r++) for (let c = 0; c < 7; c++) if (rnd(r * 9 + c) > .2) { const x = -160 + c * 52, y = -190 + r * 46; g += `<path d="M${x},${y} l18,8 l-18,8z M${x + 22},${y + 2} l10,12" fill="#7a5a3a" stroke="#5a3e24" stroke-width="3"/>`; }
  g += `<path d="M120,-230 l-30,90 l40,60 l-20,80" fill="none" stroke="${INK}" stroke-width="5"/></g>`;
  return g + txt(s.label || '', 500, 590, 50, '#fff', 'middle', .22, -2, eoBack(P(t, .5, .8)));
};
SC.fish = (s, t, b) => {   // a small fish grows huge and tows the boat
  const gr = .4 + ease(P(t, .4, 2.4)) * 1.1, x = 640 + Math.sin(t * 2) * 20;
  let g = wave(470, 40, 0, '#2f6fb0', t, b) + boat(260, 420, .6, t, b);
  g += `<line x1="350" y1="400" x2="${r1(x - 120 * gr)}" y2="${r1(470 - 10 * gr)}" stroke="${INK}" stroke-width="6"/>`;
  g += `<g transform="translate(${r1(x)},470) scale(${r1(gr * 100) / 100})"><path d="M-120,0 Q-40,-80 80,0 Q-40,80 -120,0Z" fill="#f2a33a" stroke="${INK}" stroke-width="8"/><path d="M70,0 L140,-50 L130,0 L140,50Z" fill="#e2433a" stroke="${INK}" stroke-width="7" stroke-linejoin="round"/><circle cx="-70" cy="-12" r="11" fill="${INK}"/><path d="M-30,-56 l10,-40 l20,36" fill="#e2433a" stroke="${INK}" stroke-width="6"/></g>`;
  return g + wave(520, 30, 2, '#3b88c3', t, b) + txt(s.label || '', 500, 70, 58, YEL, 'middle', .2, -2, eoBack(P(t, .3, .6)));
};
SC.birds = (s, t, b) => {   // birds sent out from the boat, a dove returns with a twig
  let g = wave(520, 30, 0, '#3b88c3', t, b) + boat(250, 480, .7, t, b);
  const k = clamp(t / 3), bx = 300 + Math.sin(k * Math.PI) * 500, by = 380 - Math.sin(k * Math.PI) * 260;
  const flap = Math.sin(t * 14) * 30;
  g += `<g transform="translate(${r1(bx)},${r1(by)}) scale(${k < .5 ? 1 : -1},1)"><ellipse cx="0" cy="0" rx="46" ry="26" fill="#fff" stroke="${INK}" stroke-width="6"/><path d="M-10,-10 L-40,${r1(-50 - flap)} L20,-14Z" fill="#fff" stroke="${INK}" stroke-width="6" stroke-linejoin="round"/><circle cx="34" cy="-8" r="5" fill="${INK}"/><path d="M44,0 l18,4 l-18,6z" fill="#f2a33a" stroke="${INK}" stroke-width="3"/>${k > .5 ? `<path d="M56,6 q20,10 34,4" stroke="#4a8a3a" stroke-width="6" fill="none"/><ellipse cx="80" cy="4" rx="10" ry="5" fill="#7cc576" stroke="${INK}" stroke-width="3"/>` : ''}</g>`;
  return g + txt(s.label || '', 500, 70, 58, YEL, 'middle', .2, -2, eoBack(P(t, .3, .6)));
};
SC.mountain = (s, t, b) => {   // the boat resting on a mountain as the water goes down
  const w = ease(P(t, .2, 2.5));
  let g = roughSVG('path', ['M120,600 Q300,330 500,140 Q700,330 880,600Z'], { fill: '#6fbf73', fillStyle: 'hachure', hachureGap: 10, fillWeight: 4, stroke: INK, strokeWidth: 7, roughness: 1.6 }, b) + poly([[420, 236], [500, 140], [580, 236], [530, 220], [500, 240], [470, 222]], '#f4f4f0', 5);
  g += boat(500, 190, .55, t * .2, b) + wave(600 - 260 * (1 - w), 30, 0, '#3b88c3', t, b);
  return g + txt(s.label || '', 500, 70, 58, YEL, 'middle', .2, -2, eoBack(P(t, .3, .6)));
};
SC.place = (s, t, b) => {   // where in the world: a spinning doodle globe, a pin drops, "today: <country>"
  const sp = eoBack(P(t, 0, .5)), pin = eoBack(P(t, .8, 1.2));
  let g = `<g transform="translate(500,330) scale(${sp})">` + roughSVG('circle', [0, 0, 440], { fill: '#6ec6ff', fillStyle: 'solid', stroke: INK, strokeWidth: 8, roughness: 1.3 }, b);
  const off = (t * 25) % 120;
  [[-120, -60, 120, 70], [40, -20, 150, 110], [-60, 110, 90, 50], [130, 120, 60, 40]].forEach(([x, y, w, h], i) => g += roughSVG('ellipse', [x - 60 + off * (i % 2 ? .3 : .2), y, w, h], { fill: '#7cc576', fillStyle: 'hachure', hachureGap: 7, fillWeight: 3, stroke: INK, strokeWidth: 5, roughness: 2 }, b + i));
  g += '</g>';
  g += `<g transform="translate(560,${r1(260 - 200 * (1 - pin))}) scale(${pin})"><path d="M0,0 C-40,-50 -40,-100 0,-100 C40,-100 40,-50 0,0Z" fill="${RED}" stroke="${INK}" stroke-width="6"/><circle cx="0" cy="-66" r="14" fill="#fff" stroke="${INK}" stroke-width="4"/></g>`;
  if (t > 1) for (let i = 0; i < 8; i++) { const a = i / 8 * Math.PI * 2, r = 40 + clamp((t - 1) / .4) * 60; g += `<line x1="${r1(560 + Math.cos(a) * r)}" y1="${r1(210 + Math.sin(a) * r)}" x2="${r1(560 + Math.cos(a) * (r + 18))}" y2="${r1(210 + Math.sin(a) * (r + 18))}" stroke="${YEL}" stroke-width="6" stroke-linecap="round" opacity="${r1(1 - clamp((t - 1.2) / .5))}"/>`; }
  return g + txt(s.label || '', 500, 70, 58, YEL, 'middle', .2, -2, eoBack(P(t, .2, .5))) + txt(s.today || '', 500, 565, 46, '#fff', 'middle', .25, 0, eoBack(P(t, 1.1, 1.5)));
};
SC.compare = (s, t, b) => {   // three columns: one symbol per tradition, ticked one by one
  const cols = s.items || [];
  let g = '';
  cols.forEach((c, i) => { const x = 180 + i * 320, p = eoBack(P(t, .2 + i * .35, .5 + i * .35));
    g += `<g transform="translate(${x},300) scale(${p})">` + roughSVG('rectangle', [-140, -170, 280, 400], { fill: '#fdfcf7', fillStyle: 'solid', stroke: INK, strokeWidth: 7 }, b + i) + '</g>';
    g += txt(c, x, 575, 34, '#fff', 'middle', .25, 0, p);
    g += `<g transform="translate(${x},300) scale(${p})">` + (i === 0 ? `<rect x="-60" y="-80" width="120" height="150" rx="10" fill="#c9a57a" stroke="${INK}" stroke-width="6"/>` : i === 1 ? boat(0, 20, .55, t).replace('<g', '<g') : `<path d="M-90,0 Q-30,-60 60,0 Q-30,60 -90,0Z" fill="#f2a33a" stroke="${INK}" stroke-width="7"/><circle cx="-50" cy="-8" r="9" fill="${INK}"/>`) + '</g>';
    if (t > 1.6 + i * .3) g += txt('✓', x + 100, 180, 90, OK, 'middle', .15, 0, eoBack(P(t, 1.6 + i * .3, 1.9 + i * .3)));
  });
  return g + txt(s.label || '', 500, 70, 52, YEL, 'middle', .2, -2, eoBack(P(t, .1, .4)));
};
/* ---------- crew ---------- */
const CREW = ['cosmo', 'zib', 'bolt', 'rocky', 'tik'];
function drawChar(who, x, y, s, st, t, b) {
  if (who === 'cosmo') return cosmo({ x, y, s: s * .78, ...st });
  if (who === 'zib') return zib({ x, y, s: s * .95, ...st });
  if (who === 'bolt') return bolt({ x, y, s: s * .9, ...st });
  if (who === 'rocky') return rocky({ x, y, s: s * .78, ...st, boil: b });
  if (who === 'sam') return sam({ x, y, s: s * .8, ...st, T: t });
  let g = tik({ x, y, s: s * .62, armL: st.armL, armR: st.armR, look: st.look || [0, 0] });
  if (st.talk > .15) g += `<g transform="translate(${r1(x)},${r1(y)}) scale(${s * .62})"><ellipse cx="9" cy="-246" rx="13" ry="${r1(4 + st.talk * 9)}" fill="#c9503f" stroke="${INK}" stroke-width="5"/></g>`;
  return g;
}
/* ---------- dynamic layer: actors, listeners, backgrounds, camera ---------- */
const SIDE = { cosmo: -1, tik: -1, zib: 1, bolt: 1, rocky: 1, sam: -1 };
const excited = (say) => /\?!|!\?|WHAT|crazy|CRAZY|Whoa|Wow|BOOM|HUGE/.test(say) || (say.match(/!/g) || []).length >= 2;
function crewRow(cx, footY, s, t, b, ctx, gap, skip) {   // listeners: idle sway, look at the speaker, small reactions
  let g = ''; const others = CREW.filter(w => w !== skip);
  others.forEach((w, i) => {
    const x = cx + (i - (others.length - 1) / 2) * gap;
    const sway = Math.sin(t * 2.2 + i * 1.3) * 4, hop = w === ctx.who ? Math.abs(Math.sin(t * 6)) * 22 * s : ctx.react && rnd(ctx.li * 7 + i) > .45 ? Math.max(0, Math.sin(Math.min(1, ctx.since / .5) * Math.PI)) * 26 * s : 0;
    const me = w === ctx.who, st = { talk: me ? ctx.talk : 0, look: [skip ? (SIDE[skip] < 0 ? -.7 : .7) : 0, -.2], armR: me ? -40 + Math.sin(t * 5.5) * 30 : 50 + Math.sin(t * 1.7 + i) * 10, armL: me ? 215 - Math.sin(t * 5.5) * 30 : 130 - Math.sin(t * 1.9 + i) * 10 };
    if (w === 'tik') { st.armR = 40; st.armL = 140; }
    const jx = (rnd(b * 3 + i) - .5) * 3, jy = (rnd(b * 5 + i) - .5) * 3, jr = (rnd(b * 7 + i) - .5) * 1.2 + sway * .4;
    g += `<g transform="translate(${r1(x + jx)},${r1(footY + jy - hop)}) rotate(${r1(jr)}) translate(${-x},${-footY})">${drawChar(w, x, footY, s * .55, st, t, b)}</g>`;
    if (ctx.react && ctx.since < 1.3 && rnd(ctx.li * 13 + i) > .5) {   // reaction bubble
      const sym = ['!', '?', '♥', '★', '!!'][Math.floor(rnd(ctx.li * 3 + i) * 5)], p = eoBack(clamp(ctx.since / .25)) * (1 - clamp((ctx.since - 1) / .3));
      g += txt(sym, x + 30 * s, footY - 230 * s - hop, 54 * s, sym === '♥' ? '#ff6b8b' : YEL, 'middle', .22, rnd(i) * 20 - 10, p);
    }
  });
  return g;
}
function actor(who, x, footY, s, T, b, ctx) {   // the speaker, big, entering and gesturing
  const side = SIDE[who], ts = ctx.since, e = eoBack(clamp(ts / .35));
  const ex = excited(ctx.say), hop = ex ? Math.max(0, Math.sin(ts * 7)) * 40 * s * Math.exp(-ts * .8) : Math.abs(Math.sin(T * 3.2)) * 6 * s;
  const fl = who === 'cosmo' ? Math.sin(T * 2.1) * 14 * s : 0;   // Cosmo floats on his jetpack
  const x0 = x - side * 520 * (1 - e), rollIn = who === 'rocky' ? (1 - e) * 360 * -side : 0;
  const sq = 1 + .045 * Math.sin(T * 13) * ctx.talk;
  const wave = Math.sin(T * 5.5) * 32, point = side < 0 ? -18 + Math.sin(T * 2) * 8 : 198 - Math.sin(T * 2) * 8;
  const st = { talk: ctx.talk, look: [side < 0 ? .7 : -.7, -.1] };
  if (side < 0) { st.armR = point; st.armL = 210 + wave; } else { st.armL = point; st.armR = -30 - wave; }
  if (who === 'sam') {   // organic gestures: a new pose on every beat, eased in (no metronome waving)
    const bt = T * 1.9, k = Math.floor(bt), fr = eio(bt - k), pose = (n) => [150 + rnd(n * 3.3) * 110, -60 + rnd(n * 5.7) * 120];
    const [a0, b0] = pose(k), [a1, b1] = pose(k + 1); st.armL = lerp(a0, a1, fr); st.armR = lerp(b0, b1, fr);
    st.tilt = Math.sin(T * 1.3) * 5 + ctx.talk * 5 * Math.sin(T * 7); st.brow = ex ? 1 : ctx.talk * .4; st.look = [Math.sin(T * .7) * .3 + .5, Math.sin(T * 1.1) * .2];
  }
  if (ex) { st.armL = 215 + wave * .5; st.armR = -35 - wave * .5; }
  let g = `<ellipse cx="${r1(x0)}" cy="${footY + 8}" rx="${95 * s}" ry="${16 * s}" fill="#000" opacity=".25"/>`;
  if (who === 'cosmo') g += `<path d="M${r1(x0 - 22 * s)},${r1(footY - 40 * s - fl)} l${r1(22 * s)},${r1((60 + Math.sin(T * 30) * 12) * s)} l${r1(22 * s)},${r1(-(60 + Math.cos(T * 27) * 12) * s)}z" fill="#ffb347" stroke="${INK}" stroke-width="4"/>`;
  g += `<g transform="translate(${r1(x0)},${r1(footY - hop - fl)}) rotate(${r1(rollIn + Math.sin(T * 2.4) * 3)}) scale(${r1(1 / sq * 100) / 100},${r1(sq * 100) / 100}) translate(${-x0},${-footY})">${drawChar(who, x0, footY, s * .55, st, T, b)}</g>`;
  if (ex && ts < 1.4) g += txt('?!', x0 + side * -10 + 70 * s, footY - 330 * s - hop, 80 * s, YEL, 'middle', .2, side * -12, eoBack(clamp(ts / .25)));
  return g;
}
const BG = { flood: ['#2b7bd6', '#6ec6ff', '#ffd23f'], mesopotamia: ['#f08a4b', '#ffcf70', '#2ec4b6'], bible: ['#7a5cff', '#b9a7ff', '#ffd23f'], hindu: ['#ff5d8f', '#ffb347', '#29c7d8'], quran: ['#2bb39a', '#7be0b0', '#ff7a6b'], fddend: ['#9b6bff', '#ff9ecb', '#ffd23f'], volcano: ['#2a1410', '#b5573a'], pulsar: ['#0b1440', '#3a5cc4'], coldest: ['#0b2a3a', '#2f8ab0'], bigstar: ['#2a0a14', '#a8243a'], bigbang: ['#1a0f3a', '#a83a7a'], sunearth: ['#2b1a0a', '#c4561e'], dinos: ['#0f2a1c', '#4a7a2f'], humans: ['#0b2152', '#1f5cb5'], moon: ['#1d1a5c', '#4a3fb0'], spin: ['#0b2152', '#1f8a8a'], sunoff: ['#2b1a0a', '#c4561e'], car: ['#1f2a52', '#d2366b'], wow: ['#0f2a1c', '#2f7a4a'], oumuamua: ['#2a1410', '#8a3a24'], tabby: ['#2b1a0a', '#b5651e'], blackhole: ['#05030c', '#3a1858'], intro: ['#1f2a52', '#3b2470'], outro: ['#1f2a52', '#3b2470'], speed: ['#2a1f5c', '#6a2470'], venus: ['#3a1c2a', '#93421f'], jupiter: ['#2b1d14', '#7a4a2a'], neptune: ['#0b2152', '#1f5cb5'], glass: ['#0d1440', '#2f3fa0'] };
const FAITH = new Set(['flood', 'mesopotamia', 'bible', 'hindu', 'quran', 'fddend']);
function paperBg(seg, W2, H2, T, b) {   // hand-made look (owner 20 Oct): cream paper, loose crayon washes that boil, a few doodled stars/sparkles
  const c = BG[seg] || BG.flood, bb = Math.floor(b / 2);
  let g = `<rect width="${W2}" height="${H2}" fill="#f1e6cf"/>`;
  g += roughSVG('rectangle', [-40, -40, W2 + 80, H2 * .62], { fill: c[1], fillStyle: 'hachure', hachureGap: 26, hachureAngle: -38, fillWeight: 14, stroke: 'none', roughness: 2.8 }, bb).replace('<g', '<g opacity=".42"');
  g += roughSVG('rectangle', [-40, H2 * .5, W2 + 80, H2 * .6], { fill: c[0], fillStyle: 'hachure', hachureGap: 30, hachureAngle: 52, fillWeight: 14, stroke: 'none', roughness: 2.8 }, bb + 7).replace('<g', '<g opacity=".28"');
  for (let i = 0; i < 9; i++) { const x = rnd(i * 4.1) * W2, y = rnd(i * 2.7) * H2 * .9, r = 10 + rnd(i) * 10, k = .7 + .3 * Math.sin(T * 2 + i);
    g += `<path d="M${r1(x - r * k)},${r1(y)} L${r1(x + r * k)},${r1(y)} M${r1(x)},${r1(y - r * k)} L${r1(x)},${r1(y + r * k)}" stroke="${i % 3 ? '#fff8e6' : (c[2] || YEL)}" stroke-width="6" stroke-linecap="round" opacity=".9"/>`; }
  return g;
}
function background(seg, W2, H2, T, b) {
  if (FAITH.has(seg)) return paperBg(seg, W2, H2, T, b);
  const c = BG[seg] || BG.intro;
  let g = `<defs><linearGradient id="bgg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${c[0]}"/><stop offset="1" stop-color="${c[1]}"/></linearGradient></defs><rect width="${W2}" height="${H2}" fill="url(#bgg)"/>`;
  for (let L = 0; L < 2; L++) for (let i = 0; i < 45; i++) {   // two parallax star layers drifting left
    const sp = L ? 38 : 14, x = ((rnd(i * 3.1 + L) * (W2 + 200) - T * sp) % (W2 + 200) + W2 + 200) % (W2 + 200) - 100, y = rnd(i * 7.7 + L * 5) * H2, tw = .5 + .5 * Math.sin(T * 3 + i);
    g += `<circle cx="${r1(x)}" cy="${r1(y)}" r="${r1((L ? 2.5 : 1.5) + tw * 2)}" fill="#fff6c8" opacity="${r1(.25 + tw * .5)}"/>`;
  }
  const sh = (T % 4.3) / 4.3; if (sh < .22) { const k = sh / .22, x = W2 * (1.1 - k * 1.3), y = H2 * (.08 + .1 * Math.floor(T / 4.3) % 3); g += `<line x1="${r1(x)}" y1="${r1(y)}" x2="${r1(x + 160)}" y2="${r1(y - 40)}" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity="${r1(1 - k)}"/>`; }
  if (seg === 'venus') for (let i = 0; i < 26; i++) { const x = rnd(i) * W2, y = H2 - ((T * (40 + rnd(i * 3) * 60) + rnd(i * 5) * H2) % H2); g += `<circle cx="${r1(x + Math.sin(T + i) * 20)}" cy="${r1(y)}" r="${r1(3 + rnd(i * 2) * 5)}" fill="${i % 2 ? '#ffb347' : '#ff6a3d'}" opacity=".7"/>`; }
  if (seg === 'jupiter') for (let i = 0; i < 6; i++) { const y = 120 + i * H2 / 6, o = (T * 30 * (i % 2 ? 1 : -1)) % 400; g += `<path d="M${-400 + o},${y} q200,40 400,0 t400,0 t400,0 t400,0 t400,0 t400,0" fill="none" stroke="${i % 2 ? '#c98a5a' : '#f3d2ae'}" stroke-width="26" opacity=".14"/>`; }
  if (seg === 'neptune') for (let i = 0; i < 16; i++) { const y = rnd(i) * H2, x = ((T * (500 + rnd(i * 3) * 400) + rnd(i * 5) * W2) % (W2 + 300)) - 150; g += `<path d="M${r1(x)},${r1(y)} q60,-10 140,0" fill="none" stroke="#bfe0ff" stroke-width="6" stroke-linecap="round" opacity=".45"/>`; }
  if (seg === 'glass') for (let i = 0; i < 14; i++) { const y = rnd(i) * H2, x = ((T * (380 + rnd(i * 3) * 300) + rnd(i * 5) * W2) % (W2 + 300)) - 150; g += `<polygon points="${r1(x)},${r1(y)} ${r1(x + 30)},${r1(y + 5)} ${r1(x + 6)},${r1(y + 15)}" fill="#e8f8ff" opacity=".55"/>`; }
  if (['intro', 'outro', 'speed'].includes(seg)) { const x = W2 * .86 + Math.sin(T * .3) * 20, y = H2 * .18; g += `<g opacity=".35">${planet('saturn', x, y, 70, T, b)}</g>`; }
  return g;
}

/* ---------- captions: chunks, current word highlighted ---------- */
function chunks(say) { const w = say.split(' '), out = []; let cur = []; for (const x of w) { cur.push(x); if (cur.length >= 3 || /[.!?,]$/.test(x)) { out.push(cur.join(' ')); cur = []; } } if (cur.length) out.push(cur.join(' ')); return out; }
function caption(line, T, x, y, size) {
  if (!line || T > line.end + .25) return '';
  const cs = chunks(line.say), tot = cs.reduce((a, c) => a + c.length, 0); let acc = 0, cur = cs[0], st = line.start, dur = 1;
  for (const c of cs) { const d = (line.end - line.start) * c.length / tot; if (T >= line.start + acc) { cur = c; st = line.start + acc; dur = d; } acc += d; }
  const ws = cur.split(' '), wl = ws.reduce((a, w) => a + w.length + 1, 0); let a2 = 0, wi = 0;
  ws.forEach((w, k) => { if (T >= st + dur * a2 / wl) wi = k; a2 += w.length + 1; });
  const pop = lerp(.75, 1, eoBack((T - st) / .14)), sz = Math.min(size, size * 16 / Math.max(10, cur.length));
  const spans = ws.map((w, k) => `<tspan fill="${k === wi || /\d|[A-Z]{3,}/.test(w) ? YEL : '#fff'}">${w.toUpperCase().replace(/&/g, '&amp;')}</tspan>`).join(' ');
  return `<g transform="translate(${x},${y}) scale(${r1(pop * 100) / 100}) rotate(${r1(Math.sin(st * 7) * 1.5)})"><text text-anchor="middle" font-family="Poppins, sans-serif" font-weight="700" font-size="${r1(sz)}" stroke="${INK}" stroke-width="${r1(sz * .2)}" paint-order="stroke" stroke-linejoin="round" letter-spacing="3">${spans}</text></g>`;
}

/* ---------- frame ---------- */
let TL = null, LAYOUT = 'long', SHORT_TITLE = '', PAPER = '';
function makePaper(w, h) { const c = document.createElement('canvas'); c.width = w / 2; c.height = h / 2; const x = c.getContext('2d'), d = x.createImageData(c.width, c.height); for (let i = 0; i < d.data.length; i += 4) { const v = Math.random(); d.data[i] = d.data[i + 1] = 235; d.data[i + 2] = 220; d.data[i + 3] = v > .5 ? (v - .5) * 34 : 0; } x.putImageData(d, 0, 0); return c.toDataURL('image/png'); }
let HOOK = '';
window.setup = (tl, layout, shortTitle) => { TL = tl; LAYOUT = layout; [SHORT_TITLE, HOOK] = (shortTitle || '').split('|').concat(['']);   // tiktok layout: "title|hook"
  const W2 = layout === 'long' ? 1920 : 1080, H2 = layout === 'long' ? 1080 : 1920; stage.setAttribute('width', W2); stage.setAttribute('height', H2); stage.setAttribute('viewBox', `0 0 ${W2} ${H2}`); PAPER = makePaper(W2, H2); };
window.renderFrame = function (f) {
  const T = f / TL.fps, b = Math.floor(T * 8) + 1;   // line boil 8x per second at any fps
  const L = TL.lines; let li = -1, si = 0;
  for (let i = 0; i < L.length; i++) { if (T >= L[i].start - .3) li = i; if (L[i].show && T >= L[i].start - .3) si = i; }
  const line = li >= 0 ? L[li] : null, sl = L[si], show = sl.show || { type: 'crew' };
  const speaking = line && T >= line.start - .1 && T <= line.end + .25;
  const ctx = { who: speaking ? line.who : null, talk: speaking ? (TL.talk[f] || 0) : 0, lineEnd: sl.end - sl.start + .3, li, since: line ? T - line.start : 9, say: line ? line.say : '', react: !!line };
  const t = T - (sl.start - .3);
  const long = LAYOUT === 'long', tk = LAYOUT === 'tiktok', W2 = long ? 1920 : 1080, H2 = long ? 1080 : 1920;
  const box = long ? { x: 430, y: 18, s: 1.06 } : tk ? { x: 25, y: 390, s: 1.03 } : { x: 25, y: 330, s: 1.03 };
  const crewScene = ['lineup', 'crew'].includes(show.type);
  // camera: slide-in + punch on scene change, slow push-in, shake on surprises
  const dir = si % 2 ? 1 : -1, tin = eo3(clamp(t / .32));
  let cx = (1 - tin) * 300 * dir, cy = 0, zoom = 1.07 - .07 * tin + .05 * clamp((t - .3) / 7);
  const shk = line && (line.sfx === 'scratch' || /BOOM|CRUNCH/i.test(line.say)) ? 16 * Math.exp(-Math.max(0, T - line.start) * 5) : 0;
  if (show.type === 'quiz' && t > ctx.lineEnd && t < ctx.lineEnd + 4) zoom += .03 * Math.sin((t - ctx.lineEnd) * Math.PI * 2);
  if (tk) { const ph = T % 2.8, lp = line ? T - line.start : 9; zoom += .05 * Math.exp(-ph * 4) + .06 * Math.exp(-Math.max(0, lp) * 5); }   // TikTok: pattern interrupt every 2.8 s + punch on every line
  cx += (rnd(f * 3) - .5) * shk; cy += (rnd(f * 5) - .5) * shk;
  const bw = 1000 * box.s, bh = 600 * box.s, mx = box.x + bw / 2, my = box.y + bh / 2;
  let g = background(line ? line.seg : 'intro', W2, H2, T, b);
  if (tk && t < .45 && FAITH.has(line ? line.seg : '')) { const k = clamp(t / .45);
    g += `<path d="M${r1(-200 + k * 1500)},0 l-260,${H2} l-180,0 l260,-${H2}z" fill="#fff8e6" opacity="${r1((1 - k) * .7)}"/>`;
    for (let i = 0; i < 12; i++) { const a = i / 12 * Math.PI * 2, r = 120 + k * 380, x = 540 + Math.cos(a) * r, y = 700 + Math.sin(a) * r * .8; g += star5(x, y, 18 * (1 - k) + 4, i % 2 ? YEL : '#ff7ab6').replace('<polygon', `<polygon opacity="${r1(1 - k)}"`); } }
  if (t < .32) g += [0, 1, 2, 3, 4].map(k => `<line x1="${r1(W2 * (k / 5) + (1 - tin) * 400 * dir)}" y1="${r1(H2 * (.15 + k * .17))}" x2="${r1(W2 * (k / 5) + 260 + (1 - tin) * 400 * dir)}" y2="${r1(H2 * (.15 + k * .17))}" stroke="#fff" stroke-width="6" stroke-linecap="round" opacity="${r1((1 - tin) * .6)}"/>`).join('');
  g += `<g transform="translate(${r1(mx + cx)},${r1(my + cy)}) scale(${r1(zoom * 1000) / 1000}) translate(${-mx},${-my})"><g transform="translate(${box.x},${box.y}) scale(${box.s})">${(SC[show.type] || SC.crew)(show, t, b, ctx)}</g></g>`;
  if (!crewScene) {
    const who = ctx.who;
    if (long) {
      g += crewRow(960, 1068, .62, T, b, ctx, 150, who);
      if (who) g += actor(who, SIDE[who] < 0 ? 215 : 1705, 1010, 2.05, T, b, ctx);
    } else if (tk) {   // TikTok: keep the bottom 22% and the right edge free for TikTok's UI; no listener row
      if (who) g += actor(who, SIDE[who] < 0 ? 280 : 760, 1540, 2.2, T, b, ctx);
    } else {
      g += crewRow(540, 1735, .62, T, b, ctx, 150, who);
      if (who) g += actor(who, SIDE[who] < 0 ? 290 : 790, 1570, 2.2, T, b, ctx);
    }
  }
  let cap = speaking ? caption(line, T, tk ? 520 : W2 / 2, long ? 760 : tk ? 1095 : 1060, long ? 62 : tk ? 96 : 82) : '';
  let top = '';
  if (tk) {   // TikTok edit (owner 20 Oct): hook card in the first 1.6 s, keyword title + progress bar, loop back to the hook in the last 0.7 s
    const end = TL.total, hk = T < 1.6 ? 1 - clamp((T - 1.3) / .3) : T > end - .7 ? clamp((T - (end - .7)) / .25) : 0;
    const ws = SHORT_TITLE.toUpperCase().split(' '), ls = ['']; for (const w of ws) { if ((ls.at(-1) + ' ' + w).trim().length > 20) ls.push(w); else ls[ls.length - 1] = (ls.at(-1) + ' ' + w).trim(); }
    ls.forEach((l, i) => top += txt(l, 520, 200 + i * 56, 50, i ? YEL : '#fff', 'middle', .2, -1.5));
    top += `<rect x="90" y="${180 + ls.length * 56}" width="860" height="14" rx="7" fill="#000" opacity=".35"/><rect x="90" y="${180 + ls.length * 56}" width="${r1(860 * clamp(T / end))}" height="14" rx="7" fill="${YEL}"/>`;
    if (hk > 0 && HOOK) {
      const hw = HOOK.toUpperCase().split(' '), hl = ['']; for (const w of hw) { if ((hl.at(-1) + ' ' + w).trim().length > 12) hl.push(w); else hl[hl.length - 1] = (hl.at(-1) + ' ' + w).trim(); }
      top += `<rect width="${W2}" height="${H2}" fill="#0b0820" opacity="${r1(hk * .78)}"/>`;
      hl.forEach((l, i) => top += txt(l, 520, 860 - (hl.length - 1) * 60 + i * 120 + (rnd(f) - .5) * 6 * hk, 118, i % 2 ? YEL : '#fff', 'middle', .16, -3 + i * 2, eoBack(clamp(T / .2)) * (.9 + .1 * hk)));
      cap = '';
    }
  } else if (!long && SHORT_TITLE) {
    const ws = SHORT_TITLE.toUpperCase().split(' '), ls = ['']; for (const w of ws) { if ((ls.at(-1) + ' ' + w).trim().length > 18) ls.push(w); else ls[ls.length - 1] = (ls.at(-1) + ' ' + w).trim(); }
    ls.forEach((l, i) => top += txt(l, 540, 170 + i * 78 - (ls.length - 1) * 20 + Math.sin(T * 2.5) * 4, 66, i ? YEL : '#fff', 'middle', .2, -2 + Math.sin(T * 1.7) * 1.2));
  }
  stage.innerHTML = `${g}<image href="${PAPER}" x="0" y="0" width="${W2}" height="${H2}" preserveAspectRatio="none"/>` + cap + top;
};
await document.fonts.ready;
window.ready = true;
